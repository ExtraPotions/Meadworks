<?xml version="1.0" encoding="utf-8"?>
<!-- Portions from SecondaryAttacks 1.2.17 (sighsorry1029), GPL-3.0, at 4375a2b17297052a773c5b143b0cae21dc655ed8:
     ILRepack.targets. SPDX-License-Identifier: GPL-3.0-only
     Changed by expDARE, 2026: Edge and YamlDotNet inputs only; no ServerSync preparation or profile deployment.
     Copyright (C) 2026 expDARE (ExtraPotions Meadworks) for the changes. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="EdgeILRepacker" AfterTargets="Build">
    <ItemGroup>
      <EdgeMergeInputs Include="$(TargetPath)"/>
      <EdgeMergeInputs Include="$(TargetDir)YamlDotNet.dll"/>
      <EdgeMergeLibraries Include="@(ReferencePath->'%(RootDir)%(Directory)')"/>
    </ItemGroup>
    <!-- No merged PDB: with DebugInfo ILRepack records its per-process temp folder in the DLL, so no two builds matched (W87). -->
    <ILRepack Parallel="true" DebugInfo="false" Internalize="true" InputAssemblies="@(EdgeMergeInputs)"
              OutputFile="$(TargetPath)" TargetKind="SameAsPrimaryAssembly" LibraryPath="@(EdgeMergeLibraries)"/>
  </Target>
</Project>
