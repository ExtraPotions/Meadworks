<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><Deterministic>true</Deterministic>
    <Authors>expDARE</Authors><Company>ExtraPotions</Company><Copyright>Copyright (C) 2026 expDARE (ExtraPotions Meadworks)</Copyright>
    <Version>0.3.35</Version><TargetFramework Condition="'$(TargetFramework)' == ''">netstandard2.1</TargetFramework>
    <GameDir Condition="'$(GameDir)' == ''">$(VALHEIM_DIR)</GameDir>
    <!-- Managed game assemblies: the client ships valheim_Data, the dedicated server (Windows or Linux) valheim_server_Data. The client folder wins when both exist. -->
    <ValheimManagedDir Condition="'$(ValheimManagedDir)' == '' And '$(GameDir)' != '' And Exists('$(GameDir)/valheim_Data/Managed')">$(GameDir)/valheim_Data/Managed</ValheimManagedDir>
    <ValheimManagedDir Condition="'$(ValheimManagedDir)' == '' And '$(GameDir)' != '' And Exists('$(GameDir)/valheim_server_Data/Managed')">$(GameDir)/valheim_server_Data/Managed</ValheimManagedDir>
    <DependencyDir Condition="'$(DependencyDir)' == ''">$(MSBuildThisFileDirectory)../assets/dependencies</DependencyDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(DependencyDir)/BepInExPack_Valheim-5.4.2351/BepInExPack_Valheim/BepInEx</BepInExDir>
    <JotunnDir Condition="'$(JotunnDir)' == ''">$(DependencyDir)/Jotunn-2.30.2/plugins</JotunnDir>
  </PropertyGroup>
  <!-- Reproducible bytes (W84, 2026-10-13). Products record every referenced assembly's MVID in their PDB, so a Crucible stamped
       with HEAD changed every product DLL on each runner-only commit. Stamp the last commit that changed what Crucible is built
       from (src, these props, the embedded console-noise.json), and map the checkout path away so two worktrees of one commit build the same bytes. -->
  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=/_/crucible/</PathMap>
  </PropertyGroup>
  <Target Name="MeadworksSourceStamp" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git log -1 --format=%25%25H -- src Directory.Build.props RuntimeReferences.props tools/Meadworks.TestRunner/console-noise.json" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_MeadworksSourceCommit"/>
    </Exec>
    <PropertyGroup><InformationalVersion Condition="'$(_MeadworksSourceCommit)' != ''">$(Version)+$(_MeadworksSourceCommit)</InformationalVersion></PropertyGroup>
  </Target>
  <Target Name="MeadworksRequireGameDir" BeforeTargets="ResolveAssemblyReferences;Build">
    <Error Condition="'$(GameDir)' == '' Or '$(ValheimManagedDir)' == '' Or !Exists('$(ValheimManagedDir)/assembly_valheim.dll')" Text="Set the VALHEIM_DIR environment variable (or pass -p:GameDir=...) to a Valheim client install (containing valheim_Data/Managed) or a Valheim dedicated server install (containing valheim_server_Data/Managed). Current GameDir: '$(GameDir)'." />
  </Target>
</Project>
