<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Thing</AssemblyName>
    <RootNamespace>ExtraPotions.Thing.Runtime</RootNamespace>
    <Nullable>annotations</Nullable>
  </PropertyGroup>
  <!-- BepInEx, Jotunn, Harmony, Unity and game references, shared with Crucible. -->
  <Import Project="$(FrozenProviderSourceRoot)/RuntimeReferences.props"/>
  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all"/>
    <Reference Include="assembly_valheim" Publicize="true" HintPath="$(ValheimManagedDir)/assembly_valheim.dll" Private="false"/>
    <Reference Include="assembly_utils" Publicize="true" HintPath="$(ValheimManagedDir)/assembly_utils.dll" Private="false"/>
    <Reference Include="assembly_guiutils" HintPath="$(ValheimManagedDir)/assembly_guiutils.dll" Private="false"/>
    <Reference Include="Unity.TextMeshPro" HintPath="$(ValheimManagedDir)/Unity.TextMeshPro.dll" Private="false"/>
    <Reference Include="gui_framework" HintPath="$(ValheimManagedDir)/gui_framework.dll" Private="false"/>
    <ProjectReference Include="../Thing.Core/Thing.Core.csproj"/>
    <Reference Include="Crucible" HintPath="$(FrozenProviderDir)/Crucible.dll" Private="false"/>
    <Reference Include="Crucible.Core" HintPath="$(FrozenProviderDir)/Crucible.Core.dll" Private="false"/>
    <Reference Include="Crucible.UI" HintPath="$(FrozenProviderDir)/Crucible.UI.dll" Private="false"/>
    <Reference Include="Crucible.Contracts" HintPath="$(FrozenProviderDir)/Crucible.Contracts.dll" Private="false"/>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../assets/localization/*.json" LogicalName="Thing.localization.%(Filename)%(Extension)"/>
    <EmbeddedResource Include="settings-tiers.json" LogicalName="$(AssemblyName).settings-tiers.json" />
  </ItemGroup>
</Project>
