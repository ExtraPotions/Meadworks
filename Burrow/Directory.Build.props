<Project><PropertyGroup><TargetFramework Condition="'$(TargetFramework)' == ''">netstandard2.1</TargetFramework><LangVersion>latest</LangVersion><Nullable>enable</Nullable><Deterministic>true</Deterministic><Version>0.3.27</Version><Authors>expDARE</Authors><Company>ExtraPotions</Company><Copyright>Copyright 2026 ExtraPotions</Copyright>
<GameDir Condition="'$(GameDir)' == ''">$(VALHEIM_DIR)</GameDir><DependencyDir>$(MSBuildThisFileDirectory)../assets/dependencies</DependencyDir><!-- One shared Crucible checkout for every Meadworks product: the canonical workspace meadworks-crucible (main). -->
<CrucibleRoot Condition="'$(CrucibleRoot)' == ''">$(MSBuildThisFileDirectory)../meadworks-crucible</CrucibleRoot><BepInExDir>$(DependencyDir)/BepInExPack_Valheim-5.4.2351/BepInExPack_Valheim/BepInEx</BepInExDir><JotunnDir>$(DependencyDir)/Jotunn-2.30.2/plugins</JotunnDir>
</PropertyGroup><Target Name="MeadworksRequireGameDir" BeforeTargets="ResolveAssemblyReferences;Build"><Error Condition="'$(GameDir)' == '' Or !Exists('$(GameDir)/valheim_Data/Managed')" Text="Set the VALHEIM_DIR environment variable (or pass -p:GameDir=...) to your Valheim install folder." /></Target>
  <!-- Reproducible bytes (W87, 2026-10-13, as Crucible d0bdaaa). Stamp the last commit that changed what the plugin is built from
       (src, assets, config, these props) instead of HEAD, and map the project path away so two worktrees of one commit build the same bytes. -->
  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap>$(MSBuildProjectDirectory)=/_/$(MSBuildProjectName)</PathMap>
  </PropertyGroup>
  <Target Name="MeadworksSourceStamp" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git log -1 --format=%25%25H -- src assets config Directory.Build.props" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_MeadworksSourceCommit"/>
    </Exec>
    <PropertyGroup><InformationalVersion Condition="'$(_MeadworksSourceCommit)' != ''">$(Version)+$(_MeadworksSourceCommit)</InformationalVersion></PropertyGroup>
  </Target>
</Project>
