<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework><AssemblyName>Mantle</AssemblyName><RootNamespace>Mantle</RootNamespace>
    <Nullable>annotations</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks><CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <Import Project="$(CrucibleRoot)/RuntimeReferences.props"/>
  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all"/>
    <PackageReference Include="YamlDotNet" Version="13.7.1"/>
    <Reference Include="Crucible" HintPath="$(CrucibleRoot)/src/Crucible.Plugin/bin/Release/netstandard2.1/Crucible.dll" Private="false"/>
    <Reference Include="Crucible.Core" HintPath="$(CrucibleRoot)/src/Crucible.Plugin/bin/Release/netstandard2.1/Crucible.Core.dll" Private="false"/>
    <Reference Include="Crucible.Contracts" HintPath="$(CrucibleRoot)/src/Crucible.Contracts/bin/Release/netstandard2.1/Crucible.Contracts.dll" Private="false"/>
    <Reference Include="Crucible.UI" HintPath="$(CrucibleRoot)/src/Crucible.UI/bin/Release/netstandard2.1/Crucible.UI.dll" Private="false"/>
    <Reference Include="assembly_valheim" Publicize="true" HintPath="$(GameDir)/valheim_Data/Managed/assembly_valheim.dll" Private="false"/>
    <Reference Include="assembly_utils" Publicize="true" HintPath="$(GameDir)/valheim_Data/Managed/assembly_utils.dll" Private="false"/>
    <Reference Include="assembly_guiutils" Publicize="true" HintPath="$(GameDir)/valheim_Data/Managed/assembly_guiutils.dll" Private="false"/>
    <Reference Include="gui_framework" HintPath="$(GameDir)/valheim_Data/Managed/gui_framework.dll" Private="false"/>
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameDir)/valheim_Data/Managed/Unity.TextMeshPro.dll" Private="false"/>
    <Reference Include="MagicaClothV2" HintPath="$(GameDir)/valheim_Data/Managed/MagicaClothV2.dll" Private="false"/>
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../Mantle.Core/Mantle.Core.csproj"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Adopted/config/*.yml" LogicalName="Mantle.config.%(Filename)%(Extension)"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="config/*.yml" LogicalName="Mantle.config.%(Filename)%(Extension)"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Adopted/assets/*.png" LogicalName="Mantle.assets.%(Filename)%(Extension)"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="settings-tiers.json" LogicalName="$(AssemblyName).settings-tiers.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../assets/localization/*.json" LogicalName="Mantle.localization.%(Filename)%(Extension)"/></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../assets/original-items/mw_mantle_items.windows" LogicalName="Mantle.original-items.windows"/>
    <EmbeddedResource Include="../../assets/original-items/mw_mantle_items.linux" LogicalName="Mantle.original-items.linux"/>
    <EmbeddedResource Include="../../assets/original-items/catalog.json" LogicalName="MeadWorks.OriginalItems.catalog.json"/>
  </ItemGroup>
</Project>
